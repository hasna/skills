{
  "name": "one-page-website",
  "version": "0.1.0",
  "private": true,
  "description": "Generate a deployable static one-page website with semantic HTML, tokenized CSS, progressive-enhancement JS, and deploy notes",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "one-page-website": "src/index.ts"
  },
  "files": [
    "src",
    "SKILL.md",
    "tsconfig.json"
  ],
  "keywords": [
    "website",
    "landing-page",
    "static-site",
    "html",
    "skill"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
