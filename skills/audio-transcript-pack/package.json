{
  "name": "audio-transcript-pack",
  "version": "0.1.0",
  "private": true,
  "description": "Build a transcript package (transcript, captions, summary, show notes, clips, repurposing copy) from a text transcript offline, or from audio/video using your own OpenAI-compatible API key",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "audio-transcript-pack": "src/index.ts"
  },
  "files": [
    "src",
    "SKILL.md",
    "tsconfig.json"
  ],
  "keywords": [
    "transcript",
    "captions",
    "srt",
    "vtt",
    "whisper",
    "podcast",
    "cli",
    "skill"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
