{
  "name": "sdk-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Generate a typed TypeScript SDK from an OpenAPI spec or a resource list",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "sdk-generator": "src/index.ts"
  },
  "files": [
    "src",
    "SKILL.md",
    "tsconfig.json"
  ],
  "keywords": [
    "openapi",
    "sdk",
    "codegen",
    "typescript",
    "cli",
    "skill"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
