{
  "name": "pdf-to-dataset",
  "version": "0.1.0",
  "private": true,
  "description": "Extract PDF tables and form fields into CSV and JSON datasets with an inferred schema and extraction report",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "pdf-to-dataset": "src/index.ts"
  },
  "files": [
    "src",
    "SKILL.md",
    "tsconfig.json"
  ],
  "keywords": [
    "pdf",
    "dataset",
    "tables",
    "extraction",
    "cli",
    "skill"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-stringify": "^6.5.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.7.0"
  }
}
