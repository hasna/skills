{
  "name": "invoice-reconciliation",
  "version": "0.1.0",
  "private": true,
  "description": "Reconcile invoice and payment CSV exports into matched rows, discrepancies, anomalies, and totals",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "invoice-reconciliation": "src/index.ts"
  },
  "files": [
    "src",
    "SKILL.md",
    "tsconfig.json"
  ],
